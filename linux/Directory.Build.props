<Project>
  <!-- every build's output under linux/build.noindex, which the repo's .gitignore already leaves out -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build.noindex/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)build.noindex/bin/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
</Project>
