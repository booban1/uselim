<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app's core, checked on the Mac on modern .NET, and on GitHub's Windows runner on .NET Framework 4.8 as
       well, the framework Uselim.exe runs on (its AES-GCM goes through Windows' own CNG there) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Uselim.Tests</RootNamespace>
    <NoWarn>$(NoWarn);SYSLIB0014</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
